# ==============================================================================
# DealHunter X - Environment Variables (.env.example)
# Configure these variables in your Vercel Project Settings > Environment Variables
# ==============================================================================

# 1. Financial Markets Data (Financial Modeling Prep MCP Server)
# Required for live financial market data, valuation metrics, and quotes
# https://smithery.ai/servers/cfocoder/financial-modeling-prep-mcp-server
FMP_API_KEY="your_financial_modeling_prep_api_key_here"
# Optional alias:
# FINANCIAL_MODELING_PREP_API_KEY="your_financial_modeling_prep_api_key_here"

# 2. Polymarket Scanner
# https://smithery.ai/servers/jordan-s648/PolymarketScan
# NO API KEY NEEDED (uses open public Gamma API)

# 3. Google Gemini AI (Optional enhancement)
# Used to synthesize and personalize Top 3 trade ideas with real-time crowd signals
GEMINI_API_KEY="your_gemini_api_key_here"

# 4. Application URL
# In Vercel, this is your production or preview deployment URL
# e.g., https://your-app.vercel.app
APP_URL="http://localhost:3000"
